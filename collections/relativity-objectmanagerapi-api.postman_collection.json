          "name": "Query admin-level Collect artifacts (Workspaces, Matters)",
          "request": {
            "name": "Query admin-level Collect artifacts (Workspaces, Matters)",
            "description": {
              "content": "Use this endpoint to retrieve Workspaces and Matters. Run with the Workspace object type to list all workspaces and their associated Matter Names. Then run with the Matter object type and a name condition to retrieve a specific Matter's ArtifactID. The workspace context -1 is required for these admin-level objects.",
              "type": "text/plain"
            },
