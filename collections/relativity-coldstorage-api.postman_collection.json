          "name": "Gets the cold storage status of a workspace",
          "request": {
            "name": "Gets the cold storage status of a workspace",
            "description": {
              "content": "Returns one of:\nOut – Workspace is not in cold storage.\nIn – Workspace is in cold storage.\nMovingOut – Retrieval has been requested; the workspace will be returned to Active by the retrieval agent after the minimum request age has elapsed.\nFor MovingOut, ActivationJobSubmittedBy and ActivationJobSubmittedOnUtc identify the user who requested retrieval (secured when the caller cannot view the user).",
              "type": "text/plain"
            },
